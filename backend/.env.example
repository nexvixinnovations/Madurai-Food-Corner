# Server Configuration
NODE_ENV=production
PORT=5000
CORS_ORIGIN=*

# PostgreSQL Database Connection (Neon DB)
DATABASE_URL="postgresql://user:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Cloudinary Credentials (Media Management)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Channel (Nodemailer / SMTP)
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Madurai Food Corner" <no-reply@maduraifoodcorner.com>

# WhatsApp Channel (Meta WhatsApp / Twilio / Interakt)
ENABLE_WHATSAPP_NOTIFICATIONS=true
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# SMS Channel (Twilio / SMS Gateway)
ENABLE_SMS_NOTIFICATIONS=true
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Push Notification Channel (FCM)
ENABLE_PUSH_NOTIFICATIONS=true
FCM_SERVER_KEY=your_fcm_server_key

# Queue Configuration
MAX_NOTIFICATION_RETRIES=3
